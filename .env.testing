# Test-only environment.
#
# WITHOUT this file, `php artisan test` boots the console app first, which loads
# .env (APP_ENV=local plus the live SQL Server credentials) into the process
# environment. PHPUnit's <env> entries do not override variables that are already
# set, so the suite ran against the real development database and RefreshDatabase
# wiped it. `--env=testing` loads this file instead, so the test database is
# always a disposable in-memory SQLite one.
APP_NAME="Link Portal (testing)"
APP_ENV=testing
APP_KEY=base64:Vl7kXZOpqQQDa+IZMtDV//bpoFMcWoa3RY/S7cYb4lE=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
